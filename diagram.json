{
  "version": 1,
  "author": "550W_Sim",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp",  "top": 0,    "left": 0,    "attrs": {} },
    { "type": "board-ssd1306",            "id": "oled", "top": -220, "left": 280,  "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led-ring",           "id": "ring", "top": 250,  "left": 260,  "attrs": { "pixels": "12" } },
    { "type": "wokwi-pushbutton",         "id": "btn",  "top": -120, "left": -180, "attrs": { "color": "blue", "label": "MODE" } },
    { "type": "wokwi-potentiometer",      "id": "pot",  "top": 60,   "left": -190, "attrs": { "value": "50" } },
    { "type": "wokwi-stepper-motor",      "id": "step", "top": 230,  "left": -180, "attrs": { "arrow": "orange", "display": "angle", "size": "17" } },
    { "type": "wokwi-buzzer",             "id": "buzz", "top": -270, "left": -180, "attrs": { "volume": "0.2" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled:VCC", "esp:3V3",   "red",   [] ],
    [ "oled:GND", "esp:GND.1", "black", [] ],
    [ "oled:SDA", "esp:8",     "green", [] ],
    [ "oled:SCL", "esp:9",     "blue",  [] ],

    [ "ring:VCC", "esp:3V3",   "red",   [] ],
    [ "ring:GND", "esp:GND.2", "black", [] ],
    [ "ring:DIN", "esp:48",    "green", [] ],

    [ "btn:1.l", "esp:4",      "green", [] ],
    [ "btn:2.l", "esp:GND.3",  "black", [] ],

    [ "pot:VCC", "esp:3V3",    "red",   [] ],
    [ "pot:GND", "esp:GND.4",  "black", [] ],
    [ "pot:SIG", "esp:5",      "orange", [] ],

    [ "step:A+", "esp:10",     "green", [] ],
    [ "step:A-", "esp:11",     "green", [] ],
    [ "step:B+", "esp:12",     "blue",  [] ],
    [ "step:B-", "esp:13",     "blue",  [] ],

    [ "buzz:1",  "esp:GND.4",  "black", [] ],
    [ "buzz:2",  "esp:14",     "red",   [] ]
  ],
  "dependencies": {}
}
